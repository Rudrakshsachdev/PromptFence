# =============================================================================
# PromptFence — Environment Variable Template
# =============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true

# Security & Cryptography
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-secure-random-64-character-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SECURE_COOKIES=false

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=promptfence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/promptfence

# Network & CORS Security
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# SSRF Protection Configuration
SSRF_ALLOW_PRIVATE_IPS=false
SSRF_DNS_TIMEOUT_SECONDS=3.0

# Rate Limiting Configuration
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=1
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=10
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# Initial Admin Seed Credentials
INITIAL_ADMIN_EMAIL=admin@promptfence.internal
INITIAL_ADMIN_PASSWORD=AdminSecurePass123!

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=PromptFence

